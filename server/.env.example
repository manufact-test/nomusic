APP_ENV=production
CELIKOM_APP_DEBUG=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
STORAGE_DRIVER=local
# Absolute private directory outside public_html and release folders.
STORAGE_PATH=
# Generate distinct random values on the server; never commit them.
AUDIO_SIGNING_KEY=
API_TEST_TOKEN=
ANALYTICS_PRIVACY_KEY=
AUDIO_TOKEN_TTL_SECONDS=600
FEATURE_REPLACEMENTS=0
FEATURE_ANALYTICS=0
# Stage 7 private owner-only upload gate. Both flags default OFF in live environments.
FEATURE_UPLOADS=0
FEATURE_OWNER_UPLOADS=0
# Stage 8 admin console is off until isolated acceptance and private owner provisioning.
FEATURE_ADMIN=0
# Stage 8 reports are private and OFF; never authorize report writes using API_TEST_TOKEN.
FEATURE_OWNER_REPORTS=0
REPORT_OWNER_TOKEN=
# Independent from read-only API_TEST_TOKEN. Random >=40 characters, private server env only.
UPLOAD_OWNER_TOKEN=
ANALYTICS_RETENTION_DAYS=30
MAX_AUDIO_SIZE=31457280
# Stage 9 customer identities. Independent of FEATURE_ADMIN and API_TEST_TOKEN.
# Keep OFF during guarded rollout; never enables trial, billing, or public uploads.
FEATURE_USER_AUTH=0

# Stage 9 email ownership: NEVER place real SMTP credentials in Git or Chrome builds.
# Do not deploy confirmed-email rollout until a real verified sender and SMTP account work.
# Supported ports 465 implicit TLS or 587 STARTTLS with CA verification.
CELIKOM_MAIL_TRANSPORT=
CELIKOM_SMTP_HOST=
CELIKOM_SMTP_PORT=465
CELIKOM_SMTP_USER=
CELIKOM_SMTP_PASSWORD=
CELIKOM_MAIL_FROM=
# Unique random >=32 character server-only pepper for verification/recovery hashes.
CELIKOM_MAIL_CODE_PEPPER=

# Stage 10: enable only after isolated CI and guarded rollout. Public writes remain OFF.
FEATURE_USER_ENTITLEMENT=0
FEATURE_UPLOADS=0
