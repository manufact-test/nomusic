{
  "name": "@celikom/extension",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "CELIKOM Chromium MV3 player integration",
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "build:unpacked": "node --disable-warning=ExperimentalWarning scripts/build.mjs --unpacked-only",
    "test": "npm run build:unpacked && node --test tests/*.test.mjs",
    "validate": "npm run build:unpacked && node scripts/validate-manifest.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
