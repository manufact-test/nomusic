{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "CELIKOM",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.2",
  "default_locale": "ru",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "CELIKOM",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*"
      ],
      "js": [
        "player/main-world-bundle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.yandex.ru/*"
      ],
      "js": [
        "content/controller-bundle.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [{ "resources": ["assets/test-audio.mp3"], "matches": ["https://music.yandex.ru/*"] }]
}
